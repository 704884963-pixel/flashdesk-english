name = "flashdesk-ai"
main = "src/index.js"
compatibility_date = "2026-09-27"

[ai]
binding = "AI"

[vars]
AI_PROVIDER = "zhipu"
AI_MODEL = "glm-5.2"
AI_LOOKUP_MODEL = "glm-4.5-air"
AI_TRANSLATION_MODEL = "glm-4.5-air"
GEMINI_MODEL = "gemini-3.8-flash"
# ZHIPU_BASE_URL = "https://open.bigmodel.cn/api/paas/v4/chat/completions"
# FLASHDESK_ALLOWED_ORIGIN = "https://your-user.github.io"
